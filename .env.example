# Copy to .env and adjust. Every value can also be set as a real environment variable.

# --- Database (MySQL 8) -----------------------------------------------------
# Either one URL...
# DATABASE_URL=mysql://checkout:change-me@127.0.0.1:3306/checkout
# ...or the individual parts:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checkout
# DB_SSL=true            # require TLS (typical for managed MySQL)
# DB_POOL_SIZE=10

# --- Admin ------------------------------------------------------------------
# Password for /admin. If unset, a random one is generated and printed at startup.
ADMIN_PASSWORD=change-me

# --- HTTP -------------------------------------------------------------------
PORT=3000
# Public https URL of this service; used to build checkout links.
# PUBLIC_URL=https://checkout.example.com
# Set to true behind a reverse proxy (nginx, Caddy, a load balancer) so client IPs come from X-Forwarded-For.
# TRUST_PROXY=true

# --- Visitor IP / geolocation / fraud signals --------------------------------
# off | truncated (default, IPv4 /24 + IPv6 /48) | full (the complete address -- consider data-protection first)
# VISIT_IP_MODE=truncated
# Local MaxMind GeoLite2 databases (https://dev.maxmind.com/geoip/geolite2-free-geolocation-data); unset = no
# country/city/ASN enrichment, the rest of checkout analytics is unaffected.
# GEOIP_CITY_DB=/path/to/GeoLite2-City.mmdb
# GEOIP_ASN_DB=/path/to/GeoLite2-ASN.mmdb
# Comma-separated ASN numbers to flag as datacenter/VPN traffic on an order (informational only, never blocking)
# RISK_DATACENTER_ASNS=AS14061,AS16509
# Order placements allowed per IP per minute
# CHECKOUT_RATE_LIMIT=30

# --- Content panels (Ads Data, Sites) ----------------------------------------
# One key per panel, for the bot that fills it (see docs/bionova-bot-connection-guide.md). Unset = that panel's API is off.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADS_DATA_KEY=
# SITES_KEY=
# PANEL_ALLOWED_IPS=203.0.113.7,203.0.113.8   # optional: only these addresses may call the panel API

# --- Behaviour --------------------------------------------------------------
# AUTO_MIGRATE=true              # run database migrations on startup
# SESSION_TTL_HOURS=24           # how long a checkout link stays valid
# ADMIN_TOKEN_TTL_HOURS=12
# WORKER_ENABLED=true            # background delivery of emails + webhooks
