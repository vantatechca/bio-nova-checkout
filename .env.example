# Copy to .env and adjust. Every value can also be set as a real environment variable.

# --- Database (MySQL 8) -----------------------------------------------------
# Either one URL...
# DATABASE_URL=mysql://checkout:change-me@127.0.0.1:3306/checkout
# ...or the individual parts:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checkout
# DB_SSL=true            # require TLS (typical for managed MySQL)
# DB_POOL_SIZE=10

# --- Admin ------------------------------------------------------------------
# Password for /admin. If unset, a random one is generated and printed at startup.
ADMIN_PASSWORD=change-me

# --- HTTP -------------------------------------------------------------------
PORT=3000
# Public https URL of this service; used to build checkout links.
# PUBLIC_URL=https://checkout.example.com
# Set to true behind a reverse proxy (nginx, Caddy, a load balancer) so client IPs come from X-Forwarded-For.
# TRUST_PROXY=true

# --- Behaviour --------------------------------------------------------------
# AUTO_MIGRATE=true              # run database migrations on startup
# SESSION_TTL_HOURS=24           # how long a checkout link stays valid
# ADMIN_TOKEN_TTL_HOURS=12
# WORKER_ENABLED=true            # background delivery of emails + webhooks
